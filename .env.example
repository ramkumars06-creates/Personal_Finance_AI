# Environment Configuration Example
PROJECT_NAME="Personal Finance Agent"
ENVIRONMENT=development
DEBUG=true

# Database Connection (SQLite default for local dev; Postgres for production)
DATABASE_URL=sqlite:///./personal_finance.db
# DATABASE_URL=postgresql://finance_user:finance_secure_password_123@localhost:5432/personal_finance

# Security & Secret Keys
SECRET_KEY=change_this_to_a_secure_random_32byte_string_in_production
ENCRYPTION_KEY=u6N_4kL-p1B9y8W2z3X4v5G6h7J8k9L0m1N2o3P4q5R=

# AI / LLM Model Configuration
# Options: "nemotron" (recommended), "gemini", or "fallback" (deterministic offline rule engine)
LLM_PROVIDER=nemotron

# NVIDIA Nemotron Models (e.g. from https://build.nvidia.com or local NIM / Ollama)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Alternative: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
NO_LLM_FALLBACK=false

# Rate Limiting & File Upload Limits
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=5
